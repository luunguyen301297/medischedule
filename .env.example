# Sao chép thành .env rồi đổi mật khẩu. File .env không đưa lên git.

# --- Postgres ---
POSTGRES_DB=medischedule
POSTGRES_USER=medischedule
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5435

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_PORT=6390

# --- MinIO ---
MINIO_ROOT_USER=medischedule
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_BUCKET=medical-files

# --- Backend (Spring Boot) ---
DB_URL=jdbc:postgresql://localhost:5435/medischedule
REDIS_HOST=localhost
MINIO_ENDPOINT=http://localhost:9010
JWT_SECRET=change-me-at-least-32-characters-long-secret
JWT_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5175
# Tài khoản quản trị tạo lúc backend khởi động lần đầu (đăng nhập bằng username hoặc email)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@medischedule.local
ADMIN_PASSWORD=admin@123
# Nạp dữ liệu demo (nội dung trang chủ, tài khoản demo). Môi trường thật đổi thành: classpath:db/migration
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
